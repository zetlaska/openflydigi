"""Vader 4 Pro (device type 105), DInput or XInput mode. Draft.

In XInput mode (045e:028e, product "Flydigi VADER4") a session detaches xpad
from interface 0 and reattaches it on exit, so the pad gives no game input for
the second or two a command takes.

    tools/flydigi-vader4 list                     # what is attached, nothing sent
    tools/flydigi-vader4 info                     # read-only
    tools/flydigi-vader4 leds                     # read-only
    tools/flydigi-vader4 leds backup              # raw blob + JSON, read-only
    tools/flydigi-vader4 leds restore FILE --experimental-write
    tools/flydigi-vader4 leds solid '#00E5FF' --brightness 80 --experimental-write
    tools/flydigi-vader4 leds off --experimental-write

Writes refuse to run without --experimental-write, and refuse anything whose
device type is not 105. See flydigi/vader4.py for what is and is not known.
"""
import argparse
import datetime
import hashlib
import json
import os
import signal
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from flydigi import device, vader4  # noqa: E402


def colour(text):
    text = text.lstrip("#")
    if len(text) != 6:
        raise argparse.ArgumentTypeError("expected #RRGGBB")
    return tuple(int(text[i:i + 2], 16) for i in (0, 2, 4))


def accepted(args):
    return (*vader4.ACCEPTED_TYPES, *args.accept_type)


def open_ctrl(args):
    """XInput sessions verify the type on open; DInput is checked by callers."""
    path = args.device or vader4.find_device()
    if path.startswith(vader4.XINPUT_PREFIX):
        return vader4.Controller(path, accept=accepted(args))
    return vader4.Controller(path)


BACKUP_DIR = os.path.expanduser("~/.local/share/openflydigi/backups")


def save_backup(blob, info, label="lighting"):
    """Raw blob plus a JSON sidecar of what it decodes to. Returns the .bin path."""
    os.makedirs(BACKUP_DIR, exist_ok=True)
    stamp = datetime.datetime.now().astimezone().strftime("%Y%m%d-%H%M%S")
    path = os.path.join(BACKUP_DIR, f"vader4-{label}-{stamp}.bin")
    n = 1
    while os.path.exists(path):
        path = os.path.join(BACKUP_DIR, f"vader4-{label}-{stamp}-{n}.bin")
        n += 1
    with open(path, "xb") as fh:
        fh.write(blob)
    side = {
        "file": os.path.basename(path),
        "saved": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
        "sha256": hashlib.sha256(blob).hexdigest(),
        "device_type": info.device_type if info else None,
        "firmware": info.firmware if info else None,
        "mode": info.mode if info else None,
        "cfg_id": 0,
        "lighting": vader4.Lighting(blob).fields(),
    }
    with open(path[:-4] + ".json", "w") as fh:
        json.dump(side, fh, indent=2)
    return path


def load_backup(path):
    with open(path, "rb") as fh:
        blob = fh.read()
    if len(blob) != vader4.LED_BLOB_LEN:
        raise vader4.ProtocolError(
            f"{path}: {len(blob)} bytes, expected {vader4.LED_BLOB_LEN}")
    side = path[:-4] + ".json" if path.endswith(".bin") else None
    if side and os.path.exists(side):
        with open(side) as fh:
            want = json.load(fh).get("sha256")
        if want and want != hashlib.sha256(blob).hexdigest():
            raise vader4.ProtocolError(f"{path}: does not match its sidecar sha256")
    return blob


def cmd_list(args):
    found = False
    for path in vader4.find_dinput_nodes():
        print(f"dinput  {path}  04b4:2412 interface 2")
        found = True
    vaders = set(vader4.find_xinput_devices(vader4_only=True))
    for dev in vader4.find_xinput_devices():
        if dev in vaders:
            print(f"xinput  {vader4.XINPUT_PREFIX}{dev}  045e:028e VADER4")
        else:
            print(f"ignored {dev}  045e:028e, product does not name a VADER4")
        found = True
    if not found:
        print("nothing attached")
    return 0


def cmd_info(args):
    with open_ctrl(args) as ctrl:
        info = vader4.read_info(ctrl)
    print(f"       Mode : {info.mode}")
    pct = info.battery_percent
    print(f"     Device : {info.device_type} ({info.name})")
    print(f"   Firmware : {info.firmware}")
    print(f"        MAC : {info.mac_text}")
    print(f"    Battery : {f'{pct}%' if pct is not None else f'raw {info.battery_raw}'}")
    print(f"        CPU : {info.cpu}, {info.connection}")
    return 0 if info.device_type in accepted(args) else 2


def cmd_leds(args):
    writing = args.action in ("solid", "off", "restore")
    if writing and not args.experimental_write:
        print("refusing: lighting writes are untested on a Vader 4 Pro; "
              "pass --experimental-write", file=sys.stderr)
        return 2
    restore_blob = None
    if args.action == "restore":
        if not args.arg:
            print("restore needs a backup .bin file", file=sys.stderr)
            return 2
        restore_blob = load_backup(args.arg)
    elif args.action == "solid":
        if args.arg is None:
            print("solid needs a colour", file=sys.stderr)
            return 2
        target_colour = colour(args.arg)
    with open_ctrl(args) as ctrl:
        info = getattr(ctrl, "info", None)
        if info is None and (writing or args.action == "backup"):
            info = vader4.require(ctrl, accept=accepted(args))   # DInput
        before = vader4.read_lighting_raw(ctrl)
        print(f"current: {vader4.Lighting(before).describe()}")
        if args.action == "backup":
            print(f"saved {save_backup(before, info)}")
            return 0
        if not writing:
            return 0
        # Every write keeps what it replaces, restore included.
        print(f"backup:  {save_backup(before, info, 'lighting-prewrite')}")
        if restore_blob is not None:
            light = vader4.Lighting(restore_blob)
        else:
            light = vader4.Lighting(before)
            if args.action == "off":
                light.set_off()
            else:
                light.set_solid(target_colour, args.brightness)
        acks = []
        sent = vader4.write_lighting(ctrl, light, acks=acks)
        numbers = [n for _, n in acks]
        print(f"wrote {sent} packets; acks {numbers[:3]}..{numbers[-3:]} "
              f"({len(acks)} for {sent} packets)")
        after = vader4.read_lighting_raw(ctrl)
        same = after == bytes(light.blob)
        print(f"readback: {vader4.Lighting(after).describe()} -- "
              f"{'matches what was written' if same else 'DIFFERS from what was written'}")
        if not same:
            diff = [i for i in range(len(after)) if after[i] != light.blob[i]]
            print(f"  {len(diff)} bytes differ, first at {diff[:8]}")
            return 1
    return 0


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--accept-type", type=int, action="append", default=[],
                    help="also accept this device type (default: 105 and 85)")
    ap.add_argument("--device", help="hidraw path or usb:<sysfs path> (default: first found, DInput first)")
    sub = ap.add_subparsers(dest="command", required=True)
    sub.add_parser("list").set_defaults(func=cmd_list)
    sub.add_parser("info").set_defaults(func=cmd_info)
    leds = sub.add_parser("leds")
    leds.add_argument("action", nargs="?",
                      choices=("show", "backup", "solid", "off", "restore"), default="show")
    leds.add_argument("arg", nargs="?", help="#RRGGBB for solid, a .bin for restore")
    leds.add_argument("--brightness", type=int)
    leds.add_argument("--experimental-write", action="store_true")
    leds.set_defaults(func=cmd_leds)
    args = ap.parse_args()
    # SIGTERM -> SystemExit, so `with` blocks still reattach xpad.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
    try:
        return args.func(args)
    except (device.DeviceNotFound, device.DeviceBusy, vader4.ProtocolError, OSError) as exc:
        print(f"flydigi-vader4: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
